# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── LLM (Moonshot / Kimi) — server-side ONLY, never NEXT_PUBLIC_ ──
# Jobs aur unke effort/token caps: src/ai/jobs.config.ts
MOONSHOT_API_KEY=

# ── Cron authentication ─────────────────────────────────────
CRON_SECRET=

# ── MCP (Claude connection — capture aur task management) ───
# Lamba random string. Unset = MCP endpoint band.
MCP_SECRET=

# ── Web Push (VAPID) ────────────────────────────────────────
# Keys banane ke liye:  npx web-push generate-vapid-keys
# Public key dono jagah same honi chahiye (server + browser).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── App ─────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
