# ── Connectors ──────────────────────────────────────────────
META_ACCESS_TOKEN=
WINDSOR_API_KEY=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_SHOP_DOMAIN=

# ── Delivery ────────────────────────────────────────────────
WASIFY_API_KEY=
RESEND_API_KEY=

# ── App ─────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
