# ── Supabase ─────────────────────────────────────────────────
# All three from: Supabase dashboard → Project Settings → API
# SUPABASE_URL and SUPABASE_ANON_KEY are accepted as alternative names.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role bypasses all security. Server only — never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Operator identity ────────────────────────────────────────
# The single address allowed to hold an operator session. Any other
# address is rejected at sign-in, not merely hidden afterwards.
# The password is NOT set here: it belongs to the Supabase Auth user for
# this address — Supabase dashboard → Authentication → Users.
OPERATOR_EMAIL=

# ── LLM (Moonshot / Kimi) — server side only ─────────────────
# Optional: without it every AI job falls back to its deterministic path
# and the app keeps working.
MOONSHOT_API_KEY=

# ── Machine callers ──────────────────────────────────────────
# Invent these: openssl rand -base64 32
CRON_SECRET=
MCP_SECRET=

# ── Web push (operator devices) ──────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── App ──────────────────────────────────────────────────────
# Optional on Vercel — falls back to the deployment URL.
# APP_BASE_URL is accepted as the older name.
APP_URL=http://localhost:3000
